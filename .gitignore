/data/
/bioseq_retriever/data/
/app/backend/bioseq_retriever/data/
/app/backend/graph_core/data/
/app/backend/graph_core/lib/
/app/backend/graph_core/output/
/graph_core/data/
/data_prep/swissprot.tsv
/data_prep/*.tsv
/data_prep/*.h5
/data_prep/*.hdf5
/data_prep/*.index
/data_prep/*.faiss
/data_prep/*.accessions.json
/data_prep/*.accessions.pkl
/data_prep/*.fasta
/data_prep/*.faa
/data_prep/*.fa
/data_prep/*.fastq
