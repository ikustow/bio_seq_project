*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
.env
.env.*

# VS Code
.vscode/
*.code-workspace

# OS files
.DS_Store

# Logs and temporary files
*.log
*.tmp
*.cache
.local/

# Node modules if any
node_modules/

# Build outputs
dist/
build/

# Secrets and local config
*.key
*.pem
*.secrets
*.secret
credentials.json
app/frontend/.streamlit/secrets.toml
streamlit_ui/.streamlit/secrets.toml

# Claude Code per-user settings
.claude/settings.local.json

